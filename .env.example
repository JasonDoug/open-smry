# ============================================================================
# Summary AI — Environment Configuration
# ============================================================================

# FastAPI Server & Database
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./.data/summary_ai.db

# Cloud LLM Providers (Optional — configure any provider you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenRouter Support (Single API key for DeepSeek, Qwen, Llama, Claude, GPT, Gemini)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.7-sonnet

# Local AI Support (Ollama, LM Studio, llama.cpp, vLLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LOCAL_OPENAI_BASE_URL=http://localhost:1234/v1
