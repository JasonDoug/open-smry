{
  "manifest_version": 3,
  "name": "Summary AI — Distraction-Free Reader & AI Summarizer",
  "version": "1.0.0",
  "description": "One-click reading, summarizing, and library filing for Firefox and Safari WebExtensions.",
  "permissions": ["activeTab", "contextMenus", "storage", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@summary-ai.open",
      "strict_min_version": "115.0"
    },
    "safari": {
      "strict_min_version": "16.4"
    }
  },
  "action": {
    "default_popup": "src/popup.html"
  },
  "background": {
    "scripts": ["src/background.mjs"],
    "type": "module"
  }
}
